plugins { id 'com.android.application' }
android {
 buildFeatures {
  buildConfig true
 }
 namespace 'com.gamaala.webseries'
 compileSdk 35
 defaultConfig {
  def tmdbApiKey = project.rootProject.file("local.properties").exists() ? new Properties().with { p -> project.rootProject.file("local.properties").withInputStream { p.load(it) }; p.getProperty("TMDB_API_KEY", "") } : ""
  buildConfigField "String", "TMDB_API_KEY", "\"${tmdbApiKey}\""
  applicationId 'com.gamaala.webseries'
  minSdk 24
  targetSdk 34
  versionCode 11
  versionName '11.0'
 }
}
dependencies {
 implementation 'androidx.appcompat:appcompat:1.7.0'
 implementation 'androidx.recyclerview:recyclerview:1.3.2'
 implementation 'androidx.media3:media3-exoplayer:1.5.1'
 implementation 'androidx.media3:media3-ui:1.5.1'
}
