            );

        meta.setPadding(
            18,8,18,8
        );

        current.addView(meta);

        TextView info =
            tv(
                x.lang
                + "  •  "
                + x.genre
                + "  •  ★ "
                + x.rating,
                13,
                MUTED,
                false
            );

        info.setPadding(
            18,0,18,8
        );

        current.addView(info);

        TextView desc =
            tv(
                x.description,
                15,
                MUTED,
