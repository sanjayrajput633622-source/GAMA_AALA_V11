from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs
import json
from pathlib import Path

PORT = 8080
BASE = Path(__file__).parent

def load_catalog():
    return json.loads(
        (BASE / "catalog.json").read_text()
    )

class Handler(BaseHTTPRequestHandler):

    def send_json(self, data, code=200):
        body = json.dumps(data).encode("utf-8")

        self.send_response(code)
        self.send_header(
            "Content-Type",
            "application/json"
        )
        self.send_header(
            "Access-Control-Allow-Origin",
            "*"
        )
        self.send_header(
            "Content-Length",
            str(len(body))
        )
        self.end_headers()

        self.wfile.write(body)

    def do_GET(self):

        parsed = urlparse(self.path)
        path = parsed.path
        query = parse_qs(parsed.query)

        if path == "/":

            self.send_json({
                "status": "GAMA AALA Content API Running"
            })
            return

        catalog = load_catalog()
        content = catalog.get("content", [])

        if path == "/api/content":

            self.send_json(catalog)
            return

        if path == "/api/video":

            tmdb_id = query.get(
                "tmdb_id",
                [""]
            )[0]

            for item in content:

                if str(
                    item.get("tmdb_id", "")
                ) == str(tmdb_id):

                    self.send_json({
                        "found": True,
                        "video_url": item.get(
                            "video_url",
                            ""
                        ),
                        "authorized": item.get(
                            "authorized",
                            False
                        )
                    })
                    return

            self.send_json({
                "found": False,
                "video_url": ""
            })

            return

        self.send_json(
            {"error": "Not found"},
            404
        )

print("================================")
print("GAMA AALA CONTENT API RUNNING")
print("VIDEO LOOKUP ENABLED")
print("API: /api/video?tmdb_id=123")
print("================================")

HTTPServer(
    ("0.0.0.0", PORT),
    Handler
).serve_forever()
